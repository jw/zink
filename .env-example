POSTGRES_DB=<Name of the database>
POSTGRES_USER=<Name of the database user>
POSTGRES_PASSWORD=<Password for the database user>
POSTGRES_HOST=<Host where the database runs>
POSTGRES_PORT=<Port to access the database>

SECRET_KEY=<The secret key for the Django settings>
DEBUG=<True or False, will always be forced to False in production>

# The custom domain(s) this site is served on, comma-separated if there's more than one.
ALLOWED_HOST=<.yourdomain.com>,<.anotherdomain.com>

# Set automatically by Render to its own <service>.onrender.com hostname;
# only needed locally/elsewhere if you want to reproduce that behavior.
RENDER_EXTERNAL_HOSTNAME=<yourservice.onrender.com>

# Render's "External Database URL" for the production Postgres instance
# (Render dashboard -> the datastore -> Connect). Only needed to run
# export-render-db.sh; never used by the app itself.
RENDER_DATABASE_URL=<postgresql://user:password@host:port/database>
